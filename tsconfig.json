{
  "compilerOptions": {
    "target": "ES2022",                  
    "module": "ESNext",                  
    "moduleResolution": "Node",         
    "strict": true,                      
    "esModuleInterop": true,            
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,          
    "types": ["node"]                   
  },
  "include": ["core", "database", "modules"],  
  "exclude": ["node_modules", "backups"]
}
